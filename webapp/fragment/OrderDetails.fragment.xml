<core:FragmentDefinition 
xmlns="sap.m"
xmlns:form="sap.ui.layout.form"
xmlns:core="sap.ui.core">

    <Panel id="panelOrderDetails" headerText="{i18n>HeaderTxtDetail}" class="sapUiResponsiveMargin" width="auto" >    

        <form:SimpleForm id="formOrderDetails" layout="ResponsiveGridLayout"
             labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="5" 
             emptySpanL="5" emptySpanM="5" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false" >
            
            <form:content>                
                    <Label id="lblDtlOrderNo"     text="{i18n>orderNum}"/>
                    <Text id="inpDtlOrderNo"      text="{OrderNum}" />

                    <Label id="lblDtlCreateDate"  text="{i18n>createDat}"/>
                    <Text id="inpDtlCreateDate"   text="{
                                                        path: 'CreateDat',
                                                        formatter: '.formatter.formatDate'
                                                    }" />        
                    
                    <Label id="lblDtlRecPlant"    text="{i18n>recPlant}"/>
                    <Text id="inpDtlRecPlant"     text="{RecPlantID} - {RecPlantDesc}"/>

                    <Label id="lblDtlDelPlant"    text="{i18n>delPlant}"/>
                    <Text id="inpDtlDelPlant"     text="{DelPlantID} - {DelPlantDesc}" />

                    <Label id="lblDtlStaus"       text="{i18n>status}"/>
                    <Text id="inpDtlStatus"       text="{Status}" />

            </form:content>

        </form:SimpleForm>        

    </Panel>

</core:FragmentDefinition>