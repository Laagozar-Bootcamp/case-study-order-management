{
  "_version": "1.76.0",
  "sap.app": {
    "id": "ordermanagement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.18.5",
      "toolsId": "9f4a0f3b-64d0-4718-a0cb-f908d99f0a3b"
    },
    "dataSources": {
      "mainService": {
        "uri": "/here/goes/your/serviceurl/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.139.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ordermanagement.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "ordermanagement.view",
        "async": true,
        "viewPath": "ordermanagement.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": [
            "TargetMain"
          ]
        },
        {
            "name": "RouteCreatePage",
            "pattern": "Create/{idOrderNo}",
            "target": [
              "TargetCreatePage"
            ]
          },
          {
            "name": "RouteDetailPage",
            "pattern": "Detail/{OrderNum}",
            "target": [
              "TargetDetailPage" ]
          },
          {
            "name": "RouteEditPage",
            "pattern": "Detail/{OrderNum}/edit",
            "target": [
              "TargetEditPage" ]
          }         
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        },

        "TargetCreatePage": {
          "viewId": "CreatePage",
          "viewName": "CreatePage",
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false
        },     

        "TargetDetailPage": {
          "viewId": "DetailPage",
          "viewName": "DetailPage"
        },
        
        "TargetEditPage": {
          "viewId": "EditPage",
          "viewName": "EditPage"
        }
      }
    },
    "rootView": {
      "viewName": "ordermanagement.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
