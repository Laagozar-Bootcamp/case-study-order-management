<mvc:View controllerName="ordermanagement.controller.DetailPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:filterbar="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">
    <Page id="pageDisplay">
        <customHeader>
            <Bar id="barHdrDetail">
                <contentLeft>
                    <Text id="txtHdrDetail" text="{i18n>titleDetail}"  class="classDetailHeader">
                    </Text>
                </contentLeft>
            </Bar>
        </customHeader>

        <!-- Display the Order Details -->
        <core:Fragment fragmentName="ordermanagement.fragment.OrderDetails" type="XML" />        
        
        <!-- Display the Product List data based on the selected Order No from Main Page -->
        <core:Fragment fragmentName="ordermanagement.fragment.ProductListDetails" type="XML" />        

        <footer>
            <OverflowToolbar id="idOToolbarDetail">
                <ToolbarSpacer id="idToolbarDetail"/>
                <Button id="idBtnDetailEdit"    text="{i18n>btnTxtDtlEdit}"    tooltip="{i18n>tooltipDtlEdit}"    press="onPressDetailEdit"/>
                <Button id="idBtnDetailCancel"  text="{i18n>btnTxtDtlCancel}"  tooltip="{i18n>tooltipDtlCancel}"  press="onPressDetailCancel"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>